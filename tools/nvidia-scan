#!/usr/bin/env python3
"""Inventory the ELF requirements of locally installed NVIDIA libraries.

The scanner deliberately has no package-manager or network integration.  It
only reads the files named on the command line (or NVIDIA-shaped files found
in the standard local library directories) and follows their DT_NEEDED edges.
The JSON output is intended to be checked into a local qualification report,
not to become a new compatibility manifest by itself.
"""

from __future__ import annotations

import argparse
import glob
import json
import os
from pathlib import Path
import struct
import sys
from collections import deque
from typing import Any, Iterable


