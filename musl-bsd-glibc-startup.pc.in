prefix=@PREFIX@
libdir=@LIBDIR@
facadelibdir=${libdir}/musl-bsd/glibc

Name: musl-bsd-glibc-startup
Description: Fail-closed startup closure for musl executables that host glibc-targeted DSOs
Version: @VERSION@
Libs: -Wl,--push-state,--no-as-needed ${pc_sysrootdir}${libdir}/libmusl-bsd-glibc-host.so.2 ${pc_sysrootdir}${facadelibdir}/libc.so.6 ${pc_sysrootdir}${facadelibdir}/libdl.so.2 ${pc_sysrootdir}${facadelibdir}/libm.so.6 ${pc_sysrootdir}${facadelibdir}/libpthread.so.0 ${pc_sysrootdir}${facadelibdir}/libresolv.so.2 ${pc_sysrootdir}${facadelibdir}/librt.so.1 ${pc_sysrootdir}${facadelibdir}/libutil.so.1 -Wl,--pop-state -Wl,-rpath,${facadelibdir}
